#Publication is the parent class
class Publication:
    def __init__(self, title, author):
        self.title = title
        self.author = author
        
    def display_info(self):
        print("Title:", self.title)
        print("Author:", self.author)
  
#Book is one of two child classes of Publication      
class Book(Publication):
    def __init__(self, title, author, number_of_pages):
        super().__init__(title, author)
        self.set_number_of_pages(number_of_pages)
        
    #Setter    
    def set_number_of_pages(self, number_of_pages):
        if number_of_pages > 0:
            self.number_of_pages = number_of_pages
        else:
            print("The number of pages must be positive")
            
    #Getter        
    def get_number_of_pages(self):
        return self.get_number_of_pages
            
    def display_info(self):
        print("Title:", self.title)
        print("Author:", self.author)
        print("Number of pages:", self.number_of_pages)
 
#Magazine is one of two child classes of Publication
class Magazine(Publication):
    def __init__(self, title, author, issue_number):
        super().__init__(title, author)
        self.set_issue_number(issue_number)
    
    #Setter 
    def set_issue_number(self, issue_number):
        if issue_number <= 0:
            print("Number of pages must be positive.")
            self.issue_number = None
        else:
            self.issue_number = issue_number
            
    #Getter       
    def get_issue_number(self):
        return self.issue_number
            
    def display_info(self):
        print("Title:", self.title)
        print("Author:", self.author)
        print("Issue Number:", self.issue_number)
        
    
#Creating objects (Sample objects)
pub1 = Publication("Journal of Experimental Psychology", "Ratchiff & Van Dongen, H.")
book1 = Book("The Hobbit", "J.R.R Tolkien", 310)
mag1 = Magazine("National Geographic", "Various Authors", 202)

#Printing information
print("Publication:")
pub1.display_info()
    
print("\nBook Information:")
book1.set_number_of_pages(-310)
book1.display_info()

print("\nMagazine Information:")
mag1.display_info()
