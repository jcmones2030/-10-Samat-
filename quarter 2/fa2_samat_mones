#Parent class
class Patient:
    def __init__(self, name: str, billamount: float):
        self.name = name
        self.billamount = billamount

    def get_name(self) -> str:
        return self.name
    def set_name(self, name: str):
        self.name = name
    def get_billamount(self) -> float:
        return self.billamount
    def set_billamount(self, billamount: float):
        if billamount >= 0:
            self.billamount = billamount
            
        else:
            self.billamount = "Invalid."
            
    def calculate_bill(self) -> float:
        return self.billamount
        
    def __str__(self):
        final_bill = self.billamount
        return (f"Patient Name: {self.get_name()}\n"
                f"Original Bill: ₱{self.get_billamount():,.2f}\n"
                f"Final Bill: ₱{self.calculate():,.2f}")


#Child class 1 of Parent Class 'Patient'
class SeniorPatient(Patient):
    def __init__(self, name: str, billamount: float):
        super().__init__(name, billamount)

    def calculate_bill(self) -> float:
        originalbill = self.get_billamount()
        return originalbill*0.80
        
    def __str__(self):
        final_bill = self.billamount * 0.80
        return (f"Patient Name: {self.get_name()}\n"
                f"Original Bill: ₱{self.get_billamount():,.2f}\n"
                f"Final Bill: ₱{self.calculate_bill():,.2f}")
                
#Child class 2 of Parent Class 'Patient'
